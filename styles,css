import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 12px);
  --radius-4xl: calc(var(--radius) + 16px);
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Inter", ui-sans-serif, system-ui, sans-serif;
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-violet: var(--violet);
  --color-violet-foreground: var(--violet-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-ring-offset-background: var(--background);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
}

:root {
  --radius: 1rem;
  --background: oklch(0.995 0.002 265);
  --foreground: oklch(0.19 0.035 265);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.19 0.035 265);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.19 0.035 265);
  --primary: oklch(0.53 0.19 264);
  --primary-foreground: oklch(0.99 0.005 265);
  --secondary: oklch(0.965 0.012 265);
  --secondary-foreground: oklch(0.28 0.05 265);
  --muted: oklch(0.965 0.01 265);
  --muted-foreground: oklch(0.53 0.03 265);
  --accent: oklch(0.95 0.03 290);
  --accent-foreground: oklch(0.3 0.12 290);
  --destructive: oklch(0.58 0.22 22);
  --destructive-foreground: oklch(0.99 0.005 265);
  --success: oklch(0.6 0.15 155);
  --success-foreground: oklch(0.99 0.005 265);
  --warning: oklch(0.75 0.15 75);
  --warning-foreground: oklch(0.22 0.05 75);
  --violet: oklch(0.55 0.23 300);
  --violet-foreground: oklch(0.99 0.005 265);
  --border: oklch(0.92 0.012 265);
  --input: oklch(0.92 0.012 265);
  --ring: oklch(0.53 0.19 264);
  --chart-1: oklch(0.53 0.19 264);
  --chart-2: oklch(0.55 0.23 300);
  --chart-3: oklch(0.65 0.16 220);
  --chart-4: oklch(0.6 0.15 155);
  --chart-5: oklch(0.75 0.15 75);
  --sidebar: oklch(0.99 0.004 265);
  --sidebar-foreground: oklch(0.19 0.035 265);
  --sidebar-primary: oklch(0.53 0.19 264);
  --sidebar-primary-foreground: oklch(0.99 0.005 265);
  --sidebar-accent: oklch(0.96 0.02 285);
  --sidebar-accent-foreground: oklch(0.3 0.1 285);
  --sidebar-border: oklch(0.92 0.012 265);
  --sidebar-ring: oklch(0.53 0.19 264);

  --glass-bg: color-mix(in oklab, white 62%, transparent);
  --glass-border: color-mix(in oklab, white 70%, transparent);
  --gradient-brand: linear-gradient(135deg, oklch(0.53 0.19 264), oklch(0.55 0.23 300));
  --gradient-soft: linear-gradient(
    135deg,
    color-mix(in oklab, oklch(0.53 0.19 264) 10%, transparent),
    color-mix(in oklab, oklch(0.55 0.23 300) 10%, transparent)
  );
  --shadow-soft: 0 1px 2px oklch(0.19 0.035 265 / 0.04), 0 12px 32px -12px oklch(0.35 0.12 275 / 0.18);
  --shadow-lift: 0 2px 4px oklch(0.19 0.035 265 / 0.05), 0 28px 60px -20px oklch(0.35 0.14 275 / 0.3);
  --shadow-glow: 0 0 0 1px color-mix(in oklab, oklch(0.53 0.19 264) 18%, transparent),
    0 20px 50px -18px oklch(0.5 0.2 280 / 0.45);
}

.dark {
  --background: oklch(0.16 0.028 265);
  --foreground: oklch(0.97 0.008 265);
  --card: oklch(0.21 0.032 265);
  --card-foreground: oklch(0.97 0.008 265);
  --popover: oklch(0.21 0.032 265);
  --popover-foreground: oklch(0.97 0.008 265);
  --primary: oklch(0.66 0.18 268);
  --primary-foreground: oklch(0.15 0.03 265);
  --secondary: oklch(0.26 0.035 265);
  --secondary-foreground: oklch(0.95 0.01 265);
  --muted: oklch(0.26 0.035 265);
  --muted-foreground: oklch(0.72 0.03 265);
  --accent: oklch(0.3 0.06 290);
  --accent-foreground: oklch(0.95 0.02 290);
  --destructive: oklch(0.65 0.2 22);
  --destructive-foreground: oklch(0.15 0.03 265);
  --success: oklch(0.7 0.15 155);
  --success-foreground: oklch(0.15 0.03 265);
  --warning: oklch(0.8 0.15 75);
  --warning-foreground: oklch(0.2 0.04 75);
  --violet: oklch(0.7 0.2 300);
  --violet-foreground: oklch(0.15 0.03 265);
  --border: oklch(1 0 0 / 12%);
  --input: oklch(1 0 0 / 16%);
  --ring: oklch(0.66 0.18 268);
  --sidebar: oklch(0.19 0.03 265);
  --sidebar-foreground: oklch(0.97 0.008 265);
  --sidebar-primary: oklch(0.66 0.18 268);
  --sidebar-primary-foreground: oklch(0.15 0.03 265);
  --sidebar-accent: oklch(0.28 0.05 285);
  --sidebar-accent-foreground: oklch(0.96 0.01 285);
  --sidebar-border: oklch(1 0 0 / 12%);
  --sidebar-ring: oklch(0.66 0.18 268);

  --glass-bg: color-mix(in oklab, oklch(0.28 0.04 268) 55%, transparent);
  --glass-border: color-mix(in oklab, white 14%, transparent);
  --shadow-soft: 0 12px 32px -14px oklch(0 0 0 / 0.6);
  --shadow-lift: 0 30px 64px -22px oklch(0 0 0 / 0.7);
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    letter-spacing: -0.025em;
  }
}

@utility glass {
  background: var(--glass-bg);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-soft);
}

@utility glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-soft);
  border-radius: var(--radius-2xl);
  transition:
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);

  &:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
}

@utility gradient-text {
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@utility gradient-brand {
  background: var(--gradient-brand);
}

@utility gradient-soft {
  background: var(--gradient-soft);
}

@utility shadow-glow {
  box-shadow: var(--shadow-glow);
}

@utility grid-lines {
  background-image:
    linear-gradient(to right, color-mix(in oklab, var(--color-border) 70%, transparent) 1px, transparent 1px),
    linear-gradient(to bottom, color-mix(in oklab, var(--color-border) 70%, transparent) 1px, transparent 1px);
  background-size: 56px 56px;
}

@keyframes float-y {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14px);
  }
}

@keyframes orb-drift {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(4%, -6%, 0) scale(1.12);
  }
}

@keyframes flow-dash {
  to {
    stroke-dashoffset: -40;
  }
}

@keyframes pulse-line {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}

@utility animate-float {
  animation: float-y 6s ease-in-out infinite;
}

@utility animate-orb {
  animation: orb-drift 18s ease-in-out infinite;
}

@utility animate-flow {
  animation: flow-dash 1.2s linear infinite;
}

@utility animate-pulse-line {
  animation: pulse-line 2.4s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
